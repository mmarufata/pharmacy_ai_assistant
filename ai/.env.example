# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını GitHub'a YÜKLEMEYİN.
GEMINI_API_KEY=buraya_anahtarinizi_yazin
# Hata alırsanız (model bulunamadı / kota) AI Studio'daki limit sayfasından açık bir model seçip değiştirin:
GEMINI_MODEL=gemini-3.8-flash
# Yerel PostgreSQL. Kullanıcı/parola gerekiyorsa: postgresql://kullanici:parola@localhost:5432/eczane_ai_test
DATABASE_URL=postgresql://localhost/eczane_ai_test
# İki Gemini çağrısı arası bekleme (saniye). 429 (kota) hatası alırsanız artırın.
LLM_MIN_INTERVAL=4
