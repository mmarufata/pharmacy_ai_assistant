# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# .env dosyası Git'e GÖNDERİLMEMELİDİR (.gitignore içinde).

# Uygulama / veri sahibi bağlantısı (tabloları oluşturur, log yazar, seed çalıştırır)
DATABASE_URL=postgresql+psycopg://pharmacy_owner:CHANGE_ME@localhost:5432/pharmacy_db

# Yapay zekâ için salt okunur kullanıcı (scripts/setup_db.py bu kullanıcıyı oluşturur)
AI_READONLY_DATABASE_URL=postgresql+psycopg://ai_readonly:CHANGE_ME_TOO@localhost:5432/pharmacy_db

# Sentetik kullanıcıların demo parolası (yalnızca seed için)
SEED_DEFAULT_PASSWORD=CHANGE_ME_DEMO

# Sorgu sınırları
AI_MAX_ROWS=500
AI_STATEMENT_TIMEOUT_MS=5000

# Testler için AYRI bir veritabanı kullanın (testler tabloları sıfırlar!)
# TEST_DATABASE_URL=postgresql+psycopg://pharmacy_owner:CHANGE_ME@localhost:5432/pharmacy_test
# TEST_AI_READONLY_DATABASE_URL=postgresql+psycopg://ai_readonly:CHANGE_ME_TOO@localhost:5432/pharmacy_test
